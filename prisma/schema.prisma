generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  EMPLOYEE
  SYSTEM_ADMIN
}

enum DepartmentRole {
  AGENT
  MANAGER
}

enum Priority {
  LOW
  STANDARD
  URGENT
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model Company {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  domain         String?
  authMode       String  @default("PASSWORD") // PASSWORD or SSO
  ssoProvider    String?
  googleClientId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users       User[]
  departments Department[]
  invitations Invitation[]

  @@map("Company")
}

model User {
  id             String       @id @default(uuid())
  companyId      String
  ssoSubject     String?
  email          String
  displayName    String
  passwordHash   String?
  platformRole   PlatformRole @default(EMPLOYEE)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships     DepartmentMember[]
  requests        Request[]          @relation("EmployeeRequests")
  claimedRequests Request[]          @relation("AgentRequests")
  documents       Document[]
  auditLogs       AuditLog[]

  @@unique([companyId, ssoSubject])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("User")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestTypes RequestType[]
  members      DepartmentMember[]
  requests     Request[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("Department")
}

model RequestType {
  id             String   @id @default(uuid())
  departmentId   String
  code           String
  name           String
  description    String?
  defaultPriority Priority @default(STANDARD)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requests   Request[]

  @@unique([departmentId, code])
  @@map("RequestType")
}

model DepartmentMember {
  id             String         @id @default(uuid())
  departmentId   String
  userId         String
  departmentRole DepartmentRole @default(AGENT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("DepartmentMember")
}

model Request {
  id             String        @id @default(uuid())
  employeeId     String
  departmentId   String
  requestTypeId  String
  title          String
  description    String        @default("")
  priority       Priority      @default(STANDARD)
  status         RequestStatus @default(PENDING)
  claimedBy      String?
  resolutionNote String?
  rejectionReason String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee    User        @relation("EmployeeRequests", fields: [employeeId], references: [id])
  department  Department  @relation(fields: [departmentId], references: [id])
  requestType RequestType @relation(fields: [requestTypeId], references: [id])
  agent       User?       @relation("AgentRequests", fields: [claimedBy], references: [id])
  documents   Document[]
  auditLogs   AuditLog[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([claimedBy])
  @@index([status])
  @@map("Request")
}

model Document {
  id               String   @id @default(uuid())
  requestId        String
  storageKey       String
  originalFilename String
  mimeType         String
  byteSize         Int
  checksum         String
  uploadedBy       String
  purgeAt          DateTime
  deletedAt        DateTime?
  createdAt        DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([requestId])
  @@map("Document")
}

model AuditLog {
  id        String   @id @default(uuid())
  requestId String
  actorId   String
  action    String
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([actorId])
  @@map("AuditLog")
}

model Invitation {
  id             String         @id @default(uuid())
  companyId      String
  email          String
  platformRole   PlatformRole   @default(EMPLOYEE)
  departmentCode String?
  departmentRole DepartmentRole?
  token          String
  expiresAt      DateTime
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([token])
  @@map("Invitation")
}
