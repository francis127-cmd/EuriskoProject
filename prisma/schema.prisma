generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  EMPLOYEE
  SYSTEM_ADMIN
}

enum DepartmentRole {
  AGENT
  MANAGER
}

enum Priority {
  LOW
  STANDARD
  URGENT
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

model Company {
  id                    String  @id @default(uuid())
  name                  String
  slug                  String  @unique
  domain                String?
  authMode              String  @default("PASSWORD") // PASSWORD, SSO, OIDC, SAML
  ssoProvider           String?
  googleClientId        String?
  mfaRequired           Boolean @default(false)
  refreshTokenExpiryDays Int     @default(7)
  oidcClientId          String?
  oidcClientSecret      String?
  oidcDiscoveryUrl      String?
  oidcIssuer            String?
  samlMetadataUrl       String?
  samlCertificate       String?
  samlCallbackUrl       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users       User[]
  departments Department[]
  invitations Invitation[]
  domainVerifications DomainVerification[]
  oidcProviders OidcProvider[]

  @@map("Company")
}

model User {
  id             String       @id @default(uuid())
  companyId      String
  ssoSubject     String?
  email          String
  displayName    String
  passwordHash   String?
  platformRole   PlatformRole @default(EMPLOYEE)
  active         Boolean      @default(true)
  mfaEnabled     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships     DepartmentMember[]
  requests        Request[]          @relation("EmployeeRequests")
  claimedRequests Request[]          @relation("AgentRequests")
  documents       Document[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  mfaSecret       MfaSecret?
  notifications   Notification[]

  @@unique([companyId, ssoSubject])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("User")
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  code        String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestTypes RequestType[]
  members      DepartmentMember[]
  requests     Request[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("Department")
}

model RequestType {
  id             String   @id @default(uuid())
  departmentId   String
  code           String
  name           String
  description    String?
  active         Boolean  @default(true)
  defaultPriority Priority @default(STANDARD)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requests   Request[]

  @@unique([departmentId, code])
  @@map("RequestType")
}

model DepartmentMember {
  id             String         @id @default(uuid())
  departmentId   String
  userId         String
  departmentRole DepartmentRole @default(AGENT)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("DepartmentMember")
}

model Request {
  id             String        @id @default(uuid())
  employeeId     String
  departmentId   String
  requestTypeId  String
  title          String
  description    String        @default("")
  priority       Priority      @default(STANDARD)
  status         RequestStatus @default(PENDING)
  claimedBy      String?
  resolutionNote String?
  rejectionReason String?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee    User        @relation("EmployeeRequests", fields: [employeeId], references: [id])
  department  Department  @relation(fields: [departmentId], references: [id])
  requestType RequestType @relation(fields: [requestTypeId], references: [id])
  agent       User?       @relation("AgentRequests", fields: [claimedBy], references: [id])
  documents   Document[]
  auditLogs   AuditLog[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([claimedBy])
  @@index([status])
  @@map("Request")
}

model Document {
  id               String   @id @default(uuid())
  requestId        String
  storageKey       String
  originalFilename String
  mimeType         String
  byteSize         Int
  checksum         String
  data             Bytes?
  uploadedBy       String
  purgeAt          DateTime
  deletedAt        DateTime?
  createdAt        DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([requestId])
  @@map("Document")
}

model AuditLog {
  id        String   @id @default(uuid())
  requestId String?
  actorId   String?
  action    String
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  request Request? @relation(fields: [requestId], references: [id])
  actor   User?     @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([actorId])
  @@map("AuditLog")
}

model Invitation {
  id             String         @id @default(uuid())
  companyId      String
  email          String
  platformRole   PlatformRole   @default(EMPLOYEE)
  departmentCode String?
  departmentRole DepartmentRole?
  token          String
  expiresAt      DateTime
  createdAt      DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([token])
  @@map("Invitation")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  family    String
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([family])
  @@map("RefreshToken")
}

model MfaSecret {
  id          String   @id @default(uuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("MfaSecret")
}

model DomainVerification {
  id         String   @id @default(uuid())
  companyId  String
  domain     String
  token      String   @unique
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, domain])
  @@index([token])
  @@map("DomainVerification")
}

model OidcProvider {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  issuer          String
  clientId        String
  clientSecret    String
  discoveryUrl    String
  redirectUri     String
  scopes          String   @default("openid email profile")
  iconUrl         String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("OidcProvider")
}

model NotificationEvent {
  id             String    @id @default(uuid())
  requestId      String?
  eventType      String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  lastError      String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, createdAt])
  @@map("NotificationEvent")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  companyId String
  type      String
  title     String
  body      String
  requestId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("Notification")
}
