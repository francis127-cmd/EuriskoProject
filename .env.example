# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# MinIO (S3-compatible local object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hr-documents
MINIO_USE_SSL=false
MINIO_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
# Cloudflare R2 (free 10GB, production object storage):
# MINIO_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MINIO_USE_SSL=true
# MINIO_FORCE_PATH_STYLE=false
# MINIO_ACCESS_KEY=<r2-token-access-key>
# MINIO_SECRET_KEY=<r2-token-secret>
# MINIO_BUCKET=hr-documents
# AWS_REGION=auto

# Email (optional — invitation emails; leave unset for manual code sharing)
# Preferred: Brevo HTTP API (works where outbound SMTP is blocked).
# Free at brevo.com (300 mails/day). Verify operationshub031@gmail.com as a
# sender (Brevo -> Senders, click the confirmation email), then create an
# API key (SMTP & API -> API Keys) and set:
#   BREVO_API_KEY=xkeysib-...
#   EMAIL_FROM=operationshub031@gmail.com
# Fallback: raw SMTP (blocked from some hosts, e.g. Render -> Gmail).
# For Gmail: host smtp.gmail.com, port 587, user your address,
# pass a Google App Password (not your login password).
BREVO_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
